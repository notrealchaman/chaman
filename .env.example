# Copy to .env and fill in your values. Secrets must never be committed.

# --- Core ---
# Runtime SQLite database (defaults to prisma/dev.db if unset)
DATABASE_FILE=prisma/dev.db
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth providers (optional; leave blank to disable the button) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Payments (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI (optional; PEAK AI falls back to a deterministic engine without a key) ---
OPENAI_API_KEY=

# --- Email (optional) ---
RESEND_API_KEY=

# --- Storage (optional) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
